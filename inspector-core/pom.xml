<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fereshtehdev</groupId>
        <artifactId>spring-inspector-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>inspector-core</artifactId>
    <name>Spring Inspector :: Core</name>
    <description>Domain model, ports and engine. Pure Java, no framework dependencies.</description>

    <properties>
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-framework-free-core</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework*</exclude>
                                        <exclude>io.projectreactor*</exclude>
                                        <exclude>info.picocli</exclude>
                                        <exclude>org.eclipse.jgit*</exclude>
                                        <exclude>tools.jackson*</exclude>
                                        <exclude>com.fasterxml.jackson*</exclude>
                                        <exclude>io.netty</exclude>
                                        <exclude>com.squareup.okhttp3</exclude>
                                        <exclude>org.apache.httpcomponents*</exclude>
                                        <exclude>jakarta.servlet</exclude>
                                        <exclude>org.thymeleaf*</exclude>
                                        <exclude>org.jline</exclude>
                                        <exclude>dev.langchain4j</exclude>
                                        <exclude>io.github.ollama4j</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
